+/* VARCO: YES while the Mac runs on battery. The power source is read again only when macOS announces a change,
+ * so checking it at every frame costs almost nothing. */
+static BOOL varco_on_battery(void)
+{
+    static int token = -1, registered;
+    static BOOL on_battery;
+    int changed = 0;
+
+    if (!registered)
+    {
+        registered = 1;
+        if (notify_register_check(kIOPSNotifyPowerSource, &token) != NOTIFY_STATUS_OK) token = -1;
+        changed = 1;
+    }
+    else if (token != -1 && notify_check(token, &changed) != NOTIFY_STATUS_OK) changed = 0;
+
+    if (changed)
+    {
+        CFTypeRef info = IOPSCopyPowerSourcesInfo();
+        if (info)
+        {
+            CFStringRef type = IOPSGetProvidingPowerSourceType(info);
+            on_battery = type && CFEqual(type, CFSTR(kIOPSBatteryPowerValue));
+            CFRelease(info);
+        }
+    }
+    return on_battery;
+}
