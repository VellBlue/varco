+/* VARCO BOOST: when a game draws at a lower resolution than its window has on screen (a DPI-unaware game in a
+ * 200% bottle, or a game set to a lower resolution), macOS stretches the image with a blurry filter. With Boost
+ * ($VARCO_BOOST=1) Varco gives D3DMetal a texture of the game's size and enlarges it to the screen's resolution
+ * with MetalFX: the game renders a quarter of the pixels and stays sharp.
+ * Order on the GPU: every command buffer the process commits signals varco_event, and the enlargement waits for
+ * the last value signalled before the game asked to present the frame. If anything is missing, the layer behaves
+ * exactly as before. */
+static int varco_boost_debug;
 
+static BOOL varco_boost_enabled(void)
+{
+    static int on = -1;
+    if (on < 0)
+    {
+        const char *env = getenv("VARCO_BOOST");
+        on = env && atoi(env) > 0 && dlopen("/System/Library/Frameworks/MetalFX.framework/MetalFX", RTLD_NOW)
+             && NSClassFromString(@"MTLFXSpatialScalerDescriptor");
+        varco_boost_debug = getenv("VARCO_BOOST_DEBUG") != NULL;
+        if (varco_boost_debug) fprintf(stderr, "VARCO BOOST: %s\n", on ? "on" : "off");
+    }
+    return on;
+}
+
+static id<MTLSharedEvent> varco_event;
+static _Atomic uint64_t varco_event_value;
+static IMP varco_orig_commit;
+static __thread int varco_own_commit;
+
+static void varco_commit(id self, SEL sel)
+{
+    if (!varco_own_commit && varco_event)
+        [(id<MTLCommandBuffer>)self encodeSignalEvent:varco_event value:atomic_fetch_add(&varco_event_value, 1) + 1];
+    ((void (*)(id, SEL))varco_orig_commit)(self, sel);
+}
+
+/* the state of one layer, kept as an associated object: WineMetalLayer keeps its original layout */
+@interface VarcoBoostState : NSObject
+{
+@public
+    CGSize virtualSize;        /* the size D3DMetal asked for */
+    BOOL active;               /* the drawable is larger than virtualSize and MetalFX enlarges */
+    id<MTLCommandQueue> queue;
+    id<MTLFXSpatialScaler> scaler;
+    id<MTLTexture> low[3];
+    unsigned int next;
+    BOOL failed;
+}
+@end
+
+@implementation VarcoBoostState
+- (void) dealloc
+{
+    int i;
+    [queue release];
+    [scaler release];
+    for (i = 0; i < 3; i++) [low[i] release];
+    [super dealloc];
+}
+@end
+
+static char varco_boost_key;
+
+/* what D3DMetal gets instead of the drawable: its texture is the low-resolution one; presenting it enlarges
+ * that texture into the real drawable and then presents the real drawable, with the same call */
+@interface VarcoBoostDrawable : NSProxy
+{
+@public
+    id<CAMetalDrawable> real;
+    id<MTLTexture> low;
+    VarcoBoostState *state;
+}
+@end
+
+@implementation VarcoBoostDrawable
+- (void) dealloc { [(id)real release]; [low release]; [state release]; [super dealloc]; }
+- (id<MTLTexture>) texture { return low; }
+- (BOOL) respondsToSelector:(SEL)sel { return [(id)real respondsToSelector:sel]; }
+- (NSMethodSignature*) methodSignatureForSelector:(SEL)sel { return [(id)real methodSignatureForSelector:sel]; }
+- (void) forwardInvocation:(NSInvocation*)inv
+{
+    const char *name = sel_getName([inv selector]);
+    if (!strncmp(name, "present", 7))
+    {
+        id<MTLCommandBuffer> cb;
+        [inv setTarget:(id)real];
+        [inv retainArguments];
+        @synchronized(state)
+        {
+            cb = [state->queue commandBuffer];
+            [cb encodeWaitForEvent:varco_event value:atomic_load(&varco_event_value)];
+            state->scaler.colorTexture = low;
+            state->scaler.outputTexture = real.texture;
+            state->scaler.inputContentWidth = low.width;
+            state->scaler.inputContentHeight = low.height;
+            [state->scaler encodeToCommandBuffer:cb];
+        }
+        [cb addScheduledHandler:^(id<MTLCommandBuffer> b) { [inv invoke]; }];
+        varco_own_commit = 1;
+        [cb commit];
+        varco_own_commit = 0;
+        return;
+    }
+    [inv invokeWithTarget:(id)real];
+}
+@end
+
