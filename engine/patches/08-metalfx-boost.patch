+/* VARCO BOOST: with a lower emulated resolution, D3DMetal centers a game's fullscreen window on the screen's
+ * real size, so the window (as large as the screen) ends up shifted by half a screen. Moving it would make
+ * D3DMetal leave fullscreen, so Windows keeps its position and only macOS shows it at the screen's corner:
+ * varco_shift_x/y is what Cocoa positions of that window lack to be Windows positions (mouse, frame changes).
+ * Only with $VARCO_BOOST=1; one window per process. */
+HWND varco_shift_hwnd;
+int varco_shift_x, varco_shift_y;
+
+static BOOL varco_shift_enabled(void)
+{
+    static int on = -1;
+    if (on < 0)
+    {
+        const char *env = getenv("VARCO_BOOST");
+        on = env && atoi(env) > 0;
+    }
+    return on;
+}
+
+static void varco_shift_frame(HWND hwnd, CGRect *frame)
+{
+    CGRect desktop;
+
+    if (!varco_shift_enabled()) return;
+    desktop = macdrv_get_desktop_rect();
+    if (frame->size.width == desktop.size.width && frame->size.height == desktop.size.height &&
+        (frame->origin.x != desktop.origin.x || frame->origin.y != desktop.origin.y))
+    {
+        varco_shift_x = frame->origin.x - desktop.origin.x;
+        varco_shift_y = frame->origin.y - desktop.origin.y;
+        varco_shift_hwnd = hwnd;
+        TRACE("VARCO: %p shown at the screen's corner, shifted by %d,%d\n", hwnd, varco_shift_x, varco_shift_y);
+        frame->origin = desktop.origin;
+    }
+    else if (varco_shift_hwnd == hwnd)
+    {
+        varco_shift_hwnd = 0;
+        varco_shift_x = varco_shift_y = 0;
+    }
 }
 
 
