 #pragma GCC diagnostic ignored "-Wdeclaration-after-statement"
 
+#include <mach/mach_time.h>
+#include <time.h>
+#include <stdio.h>
+#include <stdlib.h>
 
+/* VARCO: keeps the game at the requested pace (one frame every 1/fps seconds): sleeps for most of the wait
+ * and spins for the last millisecond, for an even cadence. If the game is late it doesn't
+ * catch up (no bursts of frames). VARCO_FPS_DEBUG=1 prints the real fps every 2 seconds. */
+static uint64_t varco_now_ns(void)
+{
+    static mach_timebase_info_data_t tb;
+    if (!tb.denom) mach_timebase_info(&tb);
+    return mach_absolute_time() * tb.numer / tb.denom;
+}
+
+static void varco_pace(int fps)
+{
+    static uint64_t next, debug_t0, debug_frames;
+    static int debug = -1;
+    const uint64_t interval = 1000000000ull / fps;
+    uint64_t now = varco_now_ns();
+
+    if (now < next)
+    {
+        uint64_t wait = next - now;
+        if (wait > 1500000)
+        {
+            struct timespec ts = { 0, (long)(wait - 1000000) };
+            nanosleep(&ts, NULL);
+        }
+        while ((now = varco_now_ns()) < next) ;
+    }
+    if (now > next + interval) next = now;   /* late: start again from now */
+    next += interval;
+
+    if (debug < 0) debug = getenv("VARCO_FPS_DEBUG") != NULL;
+    if (debug)
+    {
+        if (!debug_t0) debug_t0 = now;
+        if (++debug_frames, now - debug_t0 >= 2000000000ull)
+        {
+            fprintf(stderr, "VARCO: %.1f fps (limit %d)\n", debug_frames * 1e9 / (double)(now - debug_t0), fps);
+            debug_t0 = now; debug_frames = 0;
+        }
+    }
+}
+
