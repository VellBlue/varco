@@ -34,6 +34,57 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(macdrv_d3dmtl);
 
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* VARCO: per-game FPS limit, applied in [WineMetalLayer nextDrawable] (d3dmetal_objc.m).
+ * $VARCO_FPS_LIMIT forces a value; otherwise $WINEPREFIX/varco-fps.conf, written by Varco, is read:
+ *   "<game folder in steamapps\common, lowercase>\t<fps>"  or  "*\t<fps>" (default)
+ * The default only applies to Steam games (executables inside steamapps\common). 0 = no limit. */
+int varco_fps_limit(void)
+{
+    static int cached = -1;
+    const UNICODE_STRING *us;
+    char image[1024], line[600], needle[700];
+    const char *env, *prefix;
+    int i, n = 0, def = 0, found = -1, steam_game;
+    FILE *f;
+
+    if (cached >= 0) return cached;
+    if ((env = getenv("VARCO_FPS_LIMIT")) && *env) return cached = atoi(env);
+    /* The game's name comes from the TEB, which only exists on Wine threads: macdrv_init() computes the limit
+     * at startup; nextDrawable can arrive on a system thread (D3DMetal's queue), where it can't be read. */
+    if (!NtCurrentTeb()) return 0;
+    cached = 0;
+    if (!(prefix = getenv("WINEPREFIX"))) return 0;
+    snprintf(line, sizeof(line), "%s/varco-fps.conf", prefix);
+    if (!(f = fopen(line, "r"))) return 0;
+
+    us = &NtCurrentTeb()->Peb->ProcessParameters->ImagePathName;
+    for (i = 0; us->Buffer && i < us->Length / sizeof(WCHAR) && n < sizeof(image) - 1; i++)
+    {
+        WCHAR c = us->Buffer[i];
+        image[n++] = c < 128 ? ((c >= 'A' && c <= 'Z') ? c + 'a' - 'A' : (char)c) : '?';
+    }
+    image[n] = 0;
+    steam_game = strstr(image, "\\steamapps\\common\\") != NULL;
+
+    while (fgets(line, sizeof(line), f))
+    {
+        char *tab = strchr(line, '\t');
+        if (!tab) continue;
+        *tab = 0;
+        if (!strcmp(line, "*")) { def = atoi(tab + 1); continue; }
+        snprintf(needle, sizeof(needle), "\\steamapps\\common\\%s\\", line);
+        if (strstr(image, needle)) found = atoi(tab + 1);
+    }
+    fclose(f);
+    cached = found >= 0 ? found : (steam_game ? def : 0);
+    if (cached > 0) TRACE("VARCO: %d fps limit for %s\n", cached, debugstr_w(us->Buffer));
+    return cached;
+}
+
 typedef LONG LSTATUS;
 
