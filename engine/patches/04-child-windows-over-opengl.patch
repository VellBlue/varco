+/* VARCO: a window that draws with OpenGL/Metal (for example the EA app's Qt window) has its view above the
+ * window's content, and covers the GDI-drawn child windows it contains (there, the CEF browser with the sign-in
+ * page). On Windows the child windows stay on top; winex11 draws offscreen for this. Here the rectangles of the
+ * visible child windows are passed to Cocoa, which redraws them above the surface with the window's content;
+ * Cocoa shows them only if the window really has an OpenGL/Metal surface. Top-level windows only.
+ * Called only from WindowPosChanged: during present() win32u holds the surfaces lock, and querying windows from
+ * win32u there can hang the process. Active only in the programs listed in VARCO_CHILD_OVERLAY ("eadesktop.exe,other.exe"):
+ * in all others, games included, it does nothing (with RDR2 even just querying win32u while switching to fullscreen
+ * made it crash). */
+static BOOL child_overlay_enabled(void)
+{
+    static int enabled = -1;
+    RTL_USER_PROCESS_PARAMETERS *params;
+    const char *list, *p;
+    const WCHAR *path, *base;
+    char exe[64];
+    unsigned int i, len;
 
+    if (enabled >= 0) return enabled;
+    enabled = 0;
+    if (!(list = getenv("VARCO_CHILD_OVERLAY")) || !*list) return enabled;
+    if (!(params = NtCurrentTeb()->Peb->ProcessParameters) || !params->ImagePathName.Buffer) return enabled;
+    path = base = params->ImagePathName.Buffer;
+    len = params->ImagePathName.Length / sizeof(WCHAR);
+    for (i = 0; i < len; i++) if (path[i] == '\\' || path[i] == '/') base = path + i + 1;
+    len -= base - path;
+    if (!len || len >= sizeof(exe)) return enabled;
+    for (i = 0; i < len; i++)
+    {
+        if (base[i] > 127) return enabled;
+        exe[i] = (base[i] >= 'A' && base[i] <= 'Z') ? base[i] + 'a' - 'A' : base[i];
+    }
+    exe[len] = 0;
+    for (p = list; *p; )
+    {
+        const char *end = strchr(p, ',');
+        size_t n = end ? (size_t)(end - p) : strlen(p);
+        if (n == len && !strncmp(p, exe, n)) { enabled = 1; break; }
+        if (!end) break;
+        p = end + 1;
+    }
+    return enabled;
+}
