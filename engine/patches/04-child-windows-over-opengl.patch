+static void update_child_overlays(HWND hwnd)
+{
+    UINT dpi = NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI);
+    struct macdrv_win_data *data;
+    CGRect rects[8];
+    int count = 0, i;
+    HWND child;
+
+    for (child = NtUserGetWindowRelative(hwnd, GW_CHILD); child && count < ARRAY_SIZE(rects);
+         child = NtUserGetWindowRelative(child, GW_HWNDNEXT))
+    {
+        BOOL own_surface = FALSE;
+        RECT r;
+
+        if (!(NtUserGetWindowLongW(child, GWL_STYLE) & WS_VISIBLE)) continue;
+        /* a child window with its own OpenGL/Metal surface already has its view */
+        if ((data = get_win_data(child)))
+        {
+            own_surface = data->client_view != NULL;
+            release_win_data(data);
+        }
+        if (own_surface || !NtUserGetWindowRect(child, &r, dpi)) continue;
+        NtUserMapWindowPoints(0, hwnd, (POINT *)&r, 2, dpi);
+        if (r.right <= r.left || r.bottom <= r.top) continue;
+        rects[count++] = cgrect_from_rect(r);
+    }
+
+    if (!(data = get_win_data(hwnd))) return;
+    for (i = 0; i < count; i++)
+        rects[i] = CGRectOffset(rects[i], data->rects.client.left - data->rects.visible.left,
+                                data->rects.client.top - data->rects.visible.top);
+    /* no state is kept in macdrv_win_data: its layout stays exactly as in the original driver */
+    if (data->cocoa_window)
+    {
+        TRACE("%p: %d child windows above the surface\n", hwnd, count);
+        macdrv_set_window_child_overlays(data->cocoa_window, rects, count);
+    }
+    release_win_data(data);
+}
